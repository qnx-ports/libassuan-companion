# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=libassuan
pkgver=2.5.7
pkgrel=0
pkgdesc="IPC library used by some GnuPG related software"
url="https://www.gnupg.org/software/libassuan/index.html"
arch="all"
license="LGPL-2.1-or-later"
depends="libgpg-error qnx-io-sock"
makedepends="libgpg-error-dev qnx-io-sock-dev"
subpackages="$pkgname-static $pkgname-dev $pkgname-doc"
source="
    https://www.gnupg.org/ftp/gcrypt/libassuan/libassuan-$pkgver.tar.bz2
    0001-qnx-include-sys-select.patch
"

build() {
    ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        --enable-static
    make
}

check() {
    make check
}

package() {
    make DESTDIR="$pkgdir" install
}

